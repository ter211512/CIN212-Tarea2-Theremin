// ==========================================
// DEFINICION DE PINES
// ==========================================
const uint8_t PIN_BTN_GRAVE = 2;
const uint8_t PIN_BTN_MEDIO = 3;
const uint8_t PIN_BTN_AGUDO = 4;
const uint8_t PIN_BUZZER    = 8;
const uint8_t PIN_TRIG      = 9;
const uint8_t PIN_ECHO      = 10;

// ==========================================
// CONSTANTES DE CONFIGURACION
// ==========================================
const unsigned long TIEMPO_ANTIRREBOTE = 50;
const unsigned long INTERVALO_SENSOR   = 60;
const unsigned long TIMEOUT_ECHO       = 18000;

const float DIST_MIN_CM = 5.0;
const float DIST_MAX_CM = 30.0;

// ==========================================
// RANGOS TONALES
// ==========================================
enum RangoTonal { GRAVE, MEDIO, AGUDO };

RangoTonal rangoActivo = MEDIO;

const unsigned int FREQ_GRAVE_MIN = 131;
const unsigned int FREQ_GRAVE_MAX = 262;

const unsigned int FREQ_MEDIO_MIN = 262;
const unsigned int FREQ_MEDIO_MAX = 523;

const unsigned int FREQ_AGUDO_MIN = 523;
const unsigned int FREQ_AGUDO_MAX = 1047;

// ==========================================
// FILTRO DE DISTANCIA
// ==========================================
const uint8_t VENTANA_FILTRO = 5;

float historialDistancias[VENTANA_FILTRO];
uint8_t indiceFiltro = 0;
uint8_t muestrasValidas = 0;

unsigned long ultimoTiempoSensor = 0;

// ==========================================
// ESTRUCTURA DE LOS BOTONES
// ==========================================
struct Boton {
  uint8_t pin;
  int estadoAnterior;
  int estadoEstable;
  unsigned long ultimoTiempoRebote;
};

Boton botones[3] = {
  {PIN_BTN_GRAVE, HIGH, HIGH, 0},
  {PIN_BTN_MEDIO, HIGH, HIGH, 0},
  {PIN_BTN_AGUDO, HIGH, HIGH, 0}
};

// ==========================================
// DECLARACION DE FUNCIONES
// ==========================================
void inicializarPines();
void leerPulsadores();
float medirDistanciaCM();
float filtrarDistancia(float nuevaLectura);
void reiniciarFiltro();
void actualizarAudio(float distancia);

// ==========================================
// SETUP
// ==========================================
void setup() {
  Serial.begin(9600);

  inicializarPines();

  Serial.println(F("--- Theremin Digital Listo ---"));
  Serial.println(F("Rango activo por defecto: MEDIO"));
  Serial.println(F("Distancia util: 5 a 30 cm"));
}

// ==========================================
// LOOP PRINCIPAL
// ==========================================
void loop() {
  leerPulsadores();

  unsigned long tiempoActual = millis();

  if (tiempoActual - ultimoTiempoSensor >=
      INTERVALO_SENSOR) {

    ultimoTiempoSensor = tiempoActual;

    float distanciaCruda = medirDistanciaCM();
    float distanciaFiltrada =
        filtrarDistancia(distanciaCruda);

    actualizarAudio(distanciaFiltrada);
  }
}

// ==========================================
// INICIALIZAR PINES
// ==========================================
void inicializarPines() {
  pinMode(PIN_BTN_GRAVE, INPUT_PULLUP);
  pinMode(PIN_BTN_MEDIO, INPUT_PULLUP);
  pinMode(PIN_BTN_AGUDO, INPUT_PULLUP);

  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT);

  digitalWrite(PIN_TRIG, LOW);

  pinMode(PIN_BUZZER, OUTPUT);
  noTone(PIN_BUZZER);

  reiniciarFiltro();
}

// ==========================================
// LEER BOTONES CON ANTIRREBOTE
// ==========================================
void leerPulsadores() {
  for (uint8_t i = 0; i < 3; i++) {
    int lectura = digitalRead(botones[i].pin);

    if (lectura != botones[i].estadoAnterior) {
      botones[i].ultimoTiempoRebote = millis();
    }

    if ((millis() - botones[i].ultimoTiempoRebote) >
        TIEMPO_ANTIRREBOTE) {

      if (lectura != botones[i].estadoEstable) {
        botones[i].estadoEstable = lectura;

        
        if (botones[i].estadoEstable == LOW) {
          if (i == 0) {
            rangoActivo = GRAVE;
            Serial.println(F("[BOTON] Rango: GRAVE"));
          }
          else if (i == 1) {
            rangoActivo = MEDIO;
            Serial.println(F("[BOTON] Rango: MEDIO"));
          }
          else if (i == 2) {
            rangoActivo = AGUDO;
            Serial.println(F("[BOTON] Rango: AGUDO"));
          }
        }
      }
    }

    botones[i].estadoAnterior = lectura;
  }
}

// ==========================================
// MEDIR DISTANCIA
// ==========================================
float medirDistanciaCM() {
  digitalWrite(PIN_TRIG, LOW);
  delayMicroseconds(2);

  digitalWrite(PIN_TRIG, HIGH);
  delayMicroseconds(10);

  digitalWrite(PIN_TRIG, LOW);

  unsigned long duracion =
      pulseIn(PIN_ECHO, HIGH, TIMEOUT_ECHO);

  if (duracion == 0) {
    return -1.0;
  }

  
  float cm = (float)duracion / 58.2;

  
  if (cm < 4.0 || cm > 35.0) {
    return -1.0;
  }

  return cm;
}

// ==========================================
// REINICIAR FILTRO
// ==========================================
void reiniciarFiltro() {
  for (uint8_t i = 0; i < VENTANA_FILTRO; i++) {
    historialDistancias[i] = 0.0;
  }

  indiceFiltro = 0;
  muestrasValidas = 0;
}

// ==========================================
// FILTRAR DISTANCIA
// ==========================================
float filtrarDistancia(float nuevaLectura) {
  if (nuevaLectura < 0.0) {
    reiniciarFiltro();
    return -1.0;
  }

  historialDistancias[indiceFiltro] = nuevaLectura;

  indiceFiltro =
      (indiceFiltro + 1) % VENTANA_FILTRO;

  if (muestrasValidas < VENTANA_FILTRO) {
    muestrasValidas++;
  }

  float suma = 0.0;

  for (uint8_t i = 0; i < muestrasValidas; i++) {
    suma += historialDistancias[i];
  }

  return suma / muestrasValidas;
}

// ==========================================
// ACTUALIZAR AUDIO
// ==========================================
void actualizarAudio(float distancia) {
  if (distancia > 0.0) {
    Serial.print(F("Distancia: "));
    Serial.print((int)round(distancia));
    Serial.println(F(" cm"));
  }

  
  if (distancia < DIST_MIN_CM ||
      distancia > DIST_MAX_CM) {

    noTone(PIN_BUZZER);
    return;
  }

  float distSegura =
      constrain(distancia, DIST_MIN_CM, DIST_MAX_CM);

  unsigned int fMin;
  unsigned int fMax;

  
  switch (rangoActivo) {
    case GRAVE:
      fMin = FREQ_GRAVE_MIN;
      fMax = FREQ_GRAVE_MAX;
      break;

    case MEDIO:
      fMin = FREQ_MEDIO_MIN;
      fMax = FREQ_MEDIO_MAX;
      break;

    case AGUDO:
      fMin = FREQ_AGUDO_MIN;
      fMax = FREQ_AGUDO_MAX;
      break;

    default:
      noTone(PIN_BUZZER);
      return;
  }


  float proporcion =
      (distSegura - DIST_MIN_CM) /
      (DIST_MAX_CM - DIST_MIN_CM);


  unsigned int frecuencia =
      fMax - proporcion * (fMax - fMin);

  tone(PIN_BUZZER, frecuencia);
}
